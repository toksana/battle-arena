# Vercel AI Gateway — https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
MODEL_ID=anthropic/claude-haiku-5.5

# Upstash Redis (rate limiting). Leave empty to disable the limit, e.g. locally.
# The Vercel Marketplace integration provides KV_REST_API_URL / KV_REST_API_TOKEN;
# a manual setup may use UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
